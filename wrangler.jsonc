/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "live-heartrate",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	// Custom entry so we can export the Durable Object and route /ws before TanStack Start
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
		{ "pattern": "hr.jilles.fyi", "custom_domain": true },
		{ "pattern": "heartrate.jilles.fyi", "custom_domain": true }
	],
	"durable_objects": {
		"bindings": [{ "name": "HEART_RATE", "class_name": "HeartRate" }]
	},
	"exports": {
		"HeartRate": { "type": "durable-object", "storage": "sqlite" }
	}
	/**
	 * Secrets:
	 *   BROADCAST_TOKEN — shared secret the /broadcast page uses to publish readings.
	 *   Set with: npx wrangler secret put BROADCAST_TOKEN
	 *   Locally: put BROADCAST_TOKEN=... in .dev.vars
	 */
}
